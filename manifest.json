{
  "manifest_version": 3,
  "name": "AKL Accessibility Helper",
  "version": "1.1.9",
  "description": "Launch Windows On-Screen Keyboard from the Chrome right-click menu. Git-ready package.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
